rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-+]+$');
    }

    // Clientes policy - Authenticated admins have full access; Public guests can register
    match /clientes/{clienteId} {
      allow read, write: if isSignedIn() && isValidId(clienteId);
      allow create: if isValidId(clienteId);
    }

    // Espacos policy - Public guests can view space details (like Espaço Tropical)
    match /espacos/{espacoId} {
      allow read: if isValidId(espacoId);
      allow write: if isSignedIn() && isValidId(espacoId);
    }

    // Reservas policy - Guests can read (to check date availability) and create bookings
    match /reservas/{reservaId} {
      allow read, create: if isValidId(reservaId);
      allow update, delete: if isSignedIn() && isValidId(reservaId);
    }

    // Pagamentos policy - Guests can initiate sinal payments
    match /pagamentos/{pagamentoId} {
      allow read, create: if isValidId(pagamentoId);
      allow update, delete: if isSignedIn() && isValidId(pagamentoId);
    }

    // Contratos policy - Admins only
    match /contratos/{contratoId} {
      allow read, write: if isSignedIn() && isValidId(contratoId);
    }

    // Activity Logs policy - Admins create and inspect logs
    match /logs/{logId} {
      allow read, write: if (isSignedIn() && isValidId(logId)) || isValidId(logId);
    }

    // System Users policy - Signed in operators only
    match /system_users/{userId} {
      allow read, write: if isSignedIn() && isValidId(userId);
    }
  }
}
